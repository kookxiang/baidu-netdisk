<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://openbox.org/ file:///usr/share/openbox/menu.xsd">
  <menu id="root-menu" label="Openbox 3">
    <item label="百度网盘">
      <action name="Execute">
        <command>/opt/baidunetdisk/baidunetdisk --no-sandbox</command>
      </action>
    </item>
    <item label="Helium">
      <action name="Execute">
        <command>/usr/local/helium/chrome --no-sandbox --disable-dev-shm-usage --disable-quic --user-data-dir=/config/helium</command>
      </action>
    </item>
  </menu>
</openbox_menu>
